# Copy to .env (never commit .env). Only the public anon key belongs here.
# NEVER put the service_role key in any VITE_ variable.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Biometric adapter: mock | bridge   (mock is blocked in production builds unless VITE_ALLOW_MOCK_IN_PROD=true)
VITE_BIOMETRIC_MODE=mock
# Only for VITE_BIOMETRIC_MODE=bridge: URL of the trusted local fingerprint bridge
VITE_BIOMETRIC_BRIDGE_URL=http://127.0.0.1:8787
